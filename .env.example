# AI paneļa demo (sadaļa "Sasauc AI ekspertu paneli").
# NEKAD necommito īsto atslēgu! Šis fails ir tikai paraugs.
#
# Lokāli: nokopē šo failu kā .env.local un ieliec īsto vērtību.
# Vercel: Project Settings > Environment Variables > OPENAI_API_KEY
#
# Ja atslēga nav norādīta, demo strādā simulācijas režīmā
# ar iezīmētām parauga atbildēm.
OPENAI_API_KEY=

# Pēc izvēles: cits modelis (noklusējums ir gpt-4o-mini)
OPENAI_MODEL=
